class_name AreaTileset
extends RefCounted
## Builds a TileSet from an area atlas (one row of 8 tiles of Grid.TILE px,
## generated by tools/process_tiles.py). Every area (desert, town...) uses the
## same slots, so maps and collisions work with any atlas.
## Solid tiles get a full-tile collision polygon on physics layer 0.

## Atlas order: must match the area layouts in tools/process_tiles.py.
enum Tile { GROUND, PATH, DECOR, WATER, TREE, ROOF, WALL, DOOR }

const TILE_SIZE := Grid.TILE
const SOURCE_ID := 0
const SOLID: Array[int] = [Tile.WATER, Tile.TREE, Tile.ROOF, Tile.WALL, Tile.DOOR]


static func build(atlas: Texture2D) -> TileSet:
	var tile_set := TileSet.new()
	tile_set.tile_size = Vector2i(TILE_SIZE, TILE_SIZE)
	tile_set.add_physics_layer()

	var source := TileSetAtlasSource.new()
	source.texture = atlas
	source.texture_region_size = tile_set.tile_size
	# Add the source first so its tiles know about the physics layer.
	tile_set.add_source(source, SOURCE_ID)

	var h := TILE_SIZE / 2.0
	var square := PackedVector2Array([Vector2(-h, -h), Vector2(h, -h), Vector2(h, h), Vector2(-h, h)])
	for t in Tile.size():
		var atlas_coords := coords(t)
		source.create_tile(atlas_coords)
		if t in SOLID:
			var data := source.get_tile_data(atlas_coords, 0)
			data.add_collision_polygon(0)
			data.set_collision_polygon_points(0, 0, square)
	return tile_set


## Atlas coordinates for a tile id (all tiles live in one row).
static func coords(tile: Tile) -> Vector2i:
	return Vector2i(tile, 0)
