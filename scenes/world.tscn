[node name="ElderMelina" parent="." instance=ExtResource("3_npc")]
position = Vector2(304, 272)
display_name = "Melina, el oráculo"
heals_hero = true
sheet = ExtResource("5_elder")
lines = PackedStringArray("Bienvenido a Astelia, joven aspirante. Soy Melina, el oráculo de este pueblo.", "Las estrellas me hablaron de ti: llegas sin armadura, pero no sin destino.", "Cinco reliquias de las constelaciones forman la armadura de un guardián. Ninguna se regala: cada una se gana.", "La primera, los Brazaletes de Hércules, descansa al noreste, tras la reja de piedra.", "La reja cede cuando algo pesado reposa sobre su placa. Hércules no habría dudado en mover esa roca.")

